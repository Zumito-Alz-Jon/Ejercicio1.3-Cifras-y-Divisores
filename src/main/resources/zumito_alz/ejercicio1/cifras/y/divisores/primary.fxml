<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="66.0" prefWidth="452.0" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="zumito_alz.ejercicio1.cifras.y.divisores.PrimaryController">
   <children>
      <HBox prefHeight="26.0" prefWidth="370.0">
         <children>
            <Label prefHeight="18.0" prefWidth="113.0" text="Ingresa un número:" />
            <TextField fx:id="txtNumero" />
            <Region prefHeight="26.0" prefWidth="38.0" HBox.hgrow="ALWAYS" />
            <Button fx:id="btnAnalizar" onAction="#analizar_click" prefHeight="26.0" prefWidth="66.0" text="Analizar" />
            <Button fx:id="btnLimpiar" mnemonicParsing="false" onAction="#limpiar_click" prefHeight="26.0" prefWidth="58.0" text="Limpiar" />
         </children>
      </HBox>
      <Label text="Cantidad de cifras:" />
      <TextField fx:id="txtCantidad" />
      <Label text="Suma de cifras impares:" />
      <TextField fx:id="txtImpares" />
      <Label text="Suma de cifras pares:" />
      <TextField fx:id="txtPares" />
      <Label text="Suma total de cifras:" />
      <TextField fx:id="txtTotal" />
      <Label text="Cifra mayor:" />
      <TextField fx:id="txtMayor" />
      <Label text="Cifra menor:" />
      <TextField fx:id="txtMenor" />
      <VBox>
         <children>
            <Label text="Divisores" />
            <TextArea fx:id="txtAdivisores" prefHeight="60.0" prefWidth="412.0" />
         </children>
      </VBox>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
